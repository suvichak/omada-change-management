# /etc/omadawrite/env — root:root 0600. systemd reads it as root before
# dropping to the omadawrite user, so the service gets the secrets without the
# service account being able to read this file.
# Comments must be on their own line: systemd does not strip trailing ones.

# Bearer token the AI uses for /api/*  (generated by install.sh)
AI_TOKEN=
# Fernet key that encrypts the Omada login inside the session cookie (generated)
COOKIE_KEY=
# omadawrite@pve!ct126=<uuid>  (written by omadawrite-pve-token on the host)
PVE_TOKEN=

# Machines talk by IP only (no DNS anywhere in the box). The certificate is
# still verified — against *_TLS_NAME, sent as SNI.
OMADA_URL=https://192.168.0.213:8043
OMADA_TLS_NAME=omada.example.com
OMADA_VERIFY_TLS=true
PVE_URL=https://192.168.0.102:8006
PVE_TLS_NAME=pve1.example.com
PVE_VERIFY_TLS=true
PVE_NODE=pve1
VMID=213

DB_PATH=/var/lib/omadawrite/omadawrite.db
SNAPSHOT_PREFIX=ow-
KEEP_SNAPSHOTS=3

# Timeline of one change (see README "Watchdog"):
# before writing, the internet must answer every second for this long
PREFLIGHT_STABLE_SECONDS=5
# after the commands, no internet judgement for this long (devices re-provision)
SETTLE_SECONDS=60
# then watch this long; closes as completed once it is over AND the internet
# has been up continuously for STABLE_MINUTES
WATCH_MINUTES=5
STABLE_MINUTES=4
# internet down continuously this long after the settle -> roll VM 213 back
REVERT_AFTER_DOWN_MINUTES=5
TICK_SECONDS=5
# Bare IP = ICMP ping (needs net.ipv4.ping_group_range, set by install.sh),
# IP:port = TCP connect. Up if any answers. Bare IPs on purpose — no DNS in the check.
PROBE_TARGETS=8.8.8.8,1.0.0.1
PROBE_TIMEOUT=2

# Reviewer stays signed in (Omada login kept in the encrypted cookie) for 30 days
SESSION_HOURS=720
MAX_COMMANDS=50
ALLOWED_METHODS=GET,POST,PUT,PATCH,DELETE

# Packet-capture download (README "Capture downloads"). The only /files path a
# proposal may call; false closes it. Files go to CAPTURE_DIR (default: captures/
# next to DB_PATH). A CAPTURE_DIR outside /var/lib/omadawrite also needs adding to
# ReadWritePaths in omadawrite-web.service.
CAPTURE_DOWNLOAD=true
CAPTURE_DIR=/var/lib/omadawrite/captures
CAPTURE_MAX_MB=200
